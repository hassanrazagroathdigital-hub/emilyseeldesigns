# Supabase — Project Settings → API (or "Connect") in the Supabase dashboard.
# Both values are PUBLIC by design and are embedded in the built JavaScript.
# Security comes from Row Level Security in supabase/schema.sql.
#
# NEVER put the service_role / secret key in any VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
